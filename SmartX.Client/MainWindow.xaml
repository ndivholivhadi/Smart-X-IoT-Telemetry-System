<Window x:Class="SmartX.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X IoT Management System"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <!-- Set from MainWindow.xaml.cs: the button of the pillar you are in -->
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#2E86C1"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Width" Value="650"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent navigation bar -->
        <Border Grid.Row="0" Background="#17202A" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SMART-X" Foreground="White" FontSize="20"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <Button x:Name="NavHomeButton" Content="Main Menu" Style="{StaticResource NavButton}" Click="NavHome_Click"/>
                <Button x:Name="NavTelemetryButton" Content="Telemetry" Style="{StaticResource NavButton}" Click="TelemetryButton_Click"/>
                <Button x:Name="NavCommandButton" Content="Command Stream" Style="{StaticResource NavButton}" Click="CommandStreamButton_Click"/>
                <Button x:Name="NavTopologyButton" Content="Network Topology" Style="{StaticResource NavButton}" Click="NetworkTopologyButton_Click"/>

                <!-- Breadcrumb: where you are -->
                <TextBlock x:Name="BreadcrumbText" Text="Main Menu" Foreground="#AEB6BF"
                           VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Main menu -->
            <StackPanel x:Name="MainMenuGrid" Background="#F4F6F8"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Select an Architecture Pillar" FontSize="26"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button Style="{StaticResource MenuButton}" Click="TelemetryButton_Click">
                    <StackPanel>
                        <TextBlock Text="Sensor Data Ingestion &amp; Telemetry" FontSize="21"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="ENABLED" Foreground="Green" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButton}" Click="CommandStreamButton_Click">
                    <StackPanel>
                        <TextBlock Text="Real-Time Command Stream &amp; History" FontSize="21"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="ENABLED" Foreground="Green" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButton}" Click="NetworkTopologyButton_Click">
                    <StackPanel>
                        <TextBlock Text="Network Topology &amp; Mesh Routing" FontSize="21"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="ENABLED" Foreground="Green" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Hosts the cached pillar views -->
            <ContentControl x:Name="ContentHost" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>