<UserControl x:Class="SmartX.Client.Views.NetworkTopology"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172B4D"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#63738A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#63738A"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20" LastChildFill="False">
                <Button Content="← Main Menu" Padding="12,8" Margin="0,0,16,0"
                        Click="Back_Click" DockPanel.Dock="Left"/>
                <Button Content="Refresh" Padding="14,8" Click="Refresh_Click" DockPanel.Dock="Right"/>
                <CheckBox x:Name="AutoRefreshCheckBox" Content="Auto-refresh" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Right"/>
                <Button Content="Load demo network" Padding="12,8" Margin="0,0,16,0"
                        Click="SeedDemo_Click" DockPanel.Dock="Right"
                        ToolTip="Registers nine demo sensors in three zones"/>
            </DockPanel>

            <TextBlock Text="Network Topology &amp; Mesh Routing" FontSize="27" FontWeight="Bold" Foreground="#172B4D"/>
            <TextBlock Text="See the mesh, follow a sensor's route to the gateway, and watch the network heal when a node fails."
                       Foreground="#63738A" Margin="0,6,0,20"/>

            <!-- Summary cards -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Sensors" Foreground="#63738A"/>
                        <TextBlock x:Name="TotalDevicesText" Text="0" FontSize="27" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Online" Foreground="#63738A"/>
                        <TextBlock x:Name="OnlineDevicesText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#16803C"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Offline" Foreground="#63738A"/>
                        <TextBlock x:Name="OfflineDevicesText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#C0392B"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Reach the gateway" Foreground="#63738A"/>
                        <TextBlock x:Name="ReachableText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#2457C5"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="MST power cost" Foreground="#63738A"/>
                        <TextBlock x:Name="MstCostText" Text="0 mW" FontSize="27" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Map + tracking -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="370"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Mesh Network Map" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Hint}">
                            <Run Foreground="#16803C" Text="● Online"/>  
                            <Run Foreground="#E67E22" Text="● Unstable"/>  
                            <Run Foreground="#C0392B" Text="● Offline"/>  
                            <Run Foreground="#2457C5" Text="● Gateway"/>  
                            <Run Text="   Thick blue = minimum spanning tree.  Orange = tracked route.  Dashed = link to a down node.  Click a node to track it."/>
                        </TextBlock>

                        <Border Background="#FBFCFE" BorderBrush="#DCE3ED" BorderThickness="1"
                                CornerRadius="8" Height="470">
                            <Canvas x:Name="GraphCanvas" ClipToBounds="True" Background="Transparent"
                                    SizeChanged="GraphCanvas_SizeChanged"/>
                        </Border>

                        <TextBlock x:Name="EmptyNetworkText" Visibility="Collapsed" Style="{StaticResource Hint}"
                                   Text="No sensors are registered yet. Register one on the Telemetry page, or click Load demo network."/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Track a Sensor" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Enter a device identifier or MAC address." Style="{StaticResource Hint}"/>

                            <DockPanel Margin="0,0,0,10">
                                <Button Content="Trace route" Padding="12,6" Margin="8,0,0,0"
                                        Click="Trace_Click" DockPanel.Dock="Right"/>
                                <TextBox x:Name="TraceInput" Padding="6" VerticalContentAlignment="Center"
                                         KeyDown="TraceInput_KeyDown"/>
                            </DockPanel>

                            <TextBlock x:Name="TraceResultText" TextWrapping="Wrap" Foreground="#172B4D"
                                       Text="No sensor tracked yet."/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Simulate failure" Padding="10,5" Margin="0,0,8,0" Click="SimulateFailure_Click"
                                        ToolTip="Takes the tracked sensor offline so you can watch traffic re-route"/>
                                <Button Content="Restore" Padding="10,5" Click="Restore_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Network Health" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="HealthSummaryText" Style="{StaticResource Hint}" Text="Waiting for data..."/>

                            <ItemsControl x:Name="ReroutesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6"
                                                Padding="10" Margin="0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           Foreground="{Binding Color}"/>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- BFS connectivity -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Devices Connected to the Gateway" Style="{StaticResource CardTitle}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Found with a breadth-first search from the gateway that skips offline nodes. Hops = fewest hops to the gateway."/>

                    <DataGrid x:Name="ConnectedGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="120" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding Id}" Width="*"/>
                            <DataGridTextColumn Header="MAC address" Binding="{Binding Mac}" Width="*"/>
                            <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="*"/>
                            <DataGridTextColumn Header="Hops" Binding="{Binding Hops}" Width="70"/>
                            <DataGridTextColumn Header="Next hop" Binding="{Binding Via}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Historical telemetry (AVL tree range query) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sensor Telemetry History" Style="{StaticResource CardTitle}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Pick a sensor, a reading type and a time window (your local time). The window is found through the sensor's AVL tree without scanning every reading."/>

                    <WrapPanel Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,8" Width="190">
                            <TextBlock Text="Sensor (ID or MAC)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="HistoryDeviceBox" Padding="6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8" Width="150">
                            <TextBlock Text="Reading" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="HistoryMetricBox" SelectedIndex="0" Padding="6">
                                <ComboBoxItem Content="Soil moisture"/>
                                <ComboBoxItem Content="Power"/>
                                <ComboBoxItem Content="Valve state"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8" Width="150">
                            <TextBlock Text="From (yyyy-MM-dd HH:mm)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="HistoryFromBox" Padding="6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8" Width="150">
                            <TextBlock Text="To (yyyy-MM-dd HH:mm)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="HistoryToBox" Padding="6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
                            <Button Content="Run query" Padding="14,7" Click="RunHistory_Click"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Quick range:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#63738A"/>
                        <Button Content="Last 15 min" Padding="10,4" Margin="0,0,6,0" Click="Quick15_Click"/>
                        <Button Content="Last hour" Padding="10,4" Margin="0,0,6,0" Click="QuickHour_Click"/>
                        <Button Content="Last 24 hours" Padding="10,4" Click="QuickDay_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="140" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="2*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="HistoryStatusText" Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Run a query to see a sensor's readings."/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" Foreground="#63738A"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
