<UserControl x:Class="SmartX.Client.Views.TelemetryDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F4F6F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">
                <Button Content="← Back to Main Menu"
        Width="180"
        Padding="10,8"
        HorizontalAlignment="Left"
        Margin="0,0,0,16"
        Click="Back_Click"/>

                <TextBlock Text="Sensor Data Ingestion &amp; Telemetry"
                       FontSize="30"
                       FontWeight="Bold"/>

                <TextBlock Text="Monitor connected IoT sensors and real-time telemetry"
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

            </StackPanel>


            <!-- Summary Cards -->
            <Grid Grid.Row="1"
              Margin="0,0,0,25">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Sensors -->
                <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="TOTAL SENSORS"
                               FontSize="12"
                               Foreground="Gray"/>

                        <TextBlock Text="0"
                               x:Name="TotalSensorsText"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>


                <!-- Online -->
                <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">


                    <StackPanel>
                        <TextBlock Text="ONLINE"
                               FontSize="12"
                               Foreground="Gray"/>

                        <TextBlock Text="0"
                               x:Name="OnlineSensorsText"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>


                <!-- Offline -->
                <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">


                    <StackPanel>
                        <TextBlock Text="OFFLINE"
                               FontSize="12"
                               Foreground="Gray"/>

                        <TextBlock Text="0"
                               x:Name="OfflineSensorsText"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>


                <!-- Alerts -->
                <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="ACTIVE ALERTS"
                         FontSize="12"
                         Foreground="Gray"/>

                        <TextBlock Text="0"
                               x:Name="ActiveAlertsText"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>

            </Grid>
            <!-- System Statistics -->
            <Border Grid.Row="2"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="System Statistics"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- API Status -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="API STATUS"
                           FontSize="12"
                           Foreground="Gray"/>

                            <TextBlock x:Name="ApiStatusText"
                           Text="Checking..."
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Generated -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TELEMETRY GENERATED"
                           FontSize="12"
                           Foreground="Gray"/>

                            <TextBlock x:Name="TelemetryGeneratedText"
                           Text="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Transmitted -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TELEMETRY TRANSMITTED"
                           FontSize="12"
                           Foreground="Gray"/>

                            <TextBlock x:Name="TelemetryTransmittedText"
                           Text="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Received -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TELEMETRY RECEIVED"
                           FontSize="12"
                           Foreground="Gray"/>

                            <TextBlock x:Name="TelemetryReceivedText"
                           Text="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Stored -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="RECORDS STORED"
                           FontSize="12"
                           Foreground="Gray"/>

                            <TextBlock x:Name="RecordsStoredText"
                           Text="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>
                        </StackPanel>

                    </Grid>

                </Grid>
            </Border>

            <!-- Live Telemetry -->
            <Border Grid.Row="3"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                   Text="Live Telemetry"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                    <ComboBox x:Name="LiveTelemetryDeviceComboBox"
                              Height="34"
                              Margin="0,0,0,15"
                              SelectedIndex="0"
                              SelectionChanged="LiveTelemetryDevice_SelectionChanged"/>


                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Soil Moisture -->
                        <Border Grid.Column="0"
                    Background="#F4F6F8"
                    CornerRadius="6"
                    Padding="15"
                    Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="SOIL MOISTURE"
                               FontSize="12"
                               Foreground="Gray"/>

                                <TextBlock x:Name="SoilMoistureText"
                               Text="-- %"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                                <TextBlock x:Name="SoilMoistureDeviceText"
                               Text="Waiting for data..."
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                        <!-- Power -->
                        <Border Grid.Column="1"
                    Background="#F4F6F8"
                    CornerRadius="6"
                    Padding="15"
                    Margin="10,0,10,0">

                            <StackPanel>

                                <TextBlock Text="POWER CONSUMPTION"
                               FontSize="12"
                               Foreground="Gray"/>

                                <TextBlock x:Name="PowerText"
                               Text="-- W"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                                <TextBlock x:Name="PowerDeviceText"
                               Text="Waiting for data..."
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                        <!-- Valve -->
                        <Border Grid.Column="2"
                    Background="#F4F6F8"
                    CornerRadius="6"
                    Padding="15"
                    Margin="10,0,0,0">

                            <StackPanel>

                                <TextBlock Text="VALVE STATE"
                               FontSize="12"
                               Foreground="Gray"/>

                                <TextBlock x:Name="ValveText"
                               Text="--"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                                <TextBlock x:Name="ValveDeviceText"
                               Text="Waiting for data..."
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

            <!-- Telemetry History -->
            <Border Grid.Row="4"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="350"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">

                        <TextBlock Text="Telemetry History"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="SensorSelectionComboBox"
                      Width="180"
                      Height="32"
                      HorizontalAlignment="Right"
                      SelectionChanged="SensorSelectionComboBox_SelectionChanged"/>

                    </Grid>

                    <!-- Chart Title -->
                    <TextBlock Grid.Row="1"
                   x:Name="HistorySensorText"
                   Text="Soil Moisture History"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,15,0,10"/>

                    <!-- Chart -->
                    <lvc:CartesianChart Grid.Row="2"
                    x:Name="TelemetryChart"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="300"/>

                </Grid>

            </Border>

            <!-- Active Alerts -->
            <Border Grid.Row="5"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Device:"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>

                        <TextBox x:Name="AlertDeviceFilterTextBox"
                           Width="180"
                     Height="32"
                     Padding="6"
                     Margin="0,0,16,0"
                     ToolTip="Filter alerts by device identifier"
                     TextChanged="AlertFilter_Changed"/>

                        <TextBlock Text="Severity:"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>

                        <ComboBox x:Name="AlertSeverityFilterComboBox"
              Width="140"
              Height="32"
              Margin="0,0,16,0"
              SelectedIndex="0"
              SelectionChanged="AlertFilter_Changed">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Critical"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Information"/>
                        </ComboBox>

                        <TextBlock Text="Status:"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

                        <ComboBox x:Name="AlertStatusFilterComboBox"
              Width="140"
              Height="32"
              SelectedIndex="0"
              SelectionChanged="AlertFilter_Changed">
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Resolved"/>
                            <ComboBoxItem Content="All"/>
                        </ComboBox>
                    </WrapPanel>


                    <TextBlock Grid.Row="0"
                   Text="Active Alerts"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                    <ListBox Grid.Row="2"
                 x:Name="AlertsListBox"
                 BorderThickness="0"
                 MinHeight="100"
                 MaxHeight="300"
                 HorizontalContentAlignment="Stretch">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#FFF4F4"
                            BorderBrush="#E74C3C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                       Text="{Binding Severity}"
                                       FontWeight="Bold"
                                       Foreground="#C0392B"
                                       VerticalAlignment="Top"/>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock Text="{Binding DeviceIdentifier}"
                                           FontWeight="Bold"
                                           FontSize="14"/>

                                            <TextBlock Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>

                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                       Text="{Binding Timestamp}"
                                       Foreground="Gray"
                                       HorizontalAlignment="Right"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- Register Sensor -->
            <Border Grid.Row="6"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                   Text="Register Sensor"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Device Identifier -->
                        <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">

                            <TextBlock Text="Device Identifier"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                            <TextBox x:Name="DeviceIdentifierTextBox"
                         Height="35"
                         Padding="8"/>
                        </StackPanel>

                        <!-- Deployment Location -->
                        <StackPanel Grid.Column="1"
                        Margin="10,0,10,0">

                            <TextBlock Text="Deployment Location"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                            <TextBox x:Name="DeploymentLocationTextBox"
                         Height="35"
                         Padding="8"/>
                        </StackPanel>

                        <!-- Zone -->
                        <StackPanel Grid.Column="2"
                        Margin="10,0,10,0">

                            <TextBlock Text="Zone"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                            <TextBox x:Name="ZoneTextBox"
                         Height="35"
                         Padding="8"/>
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Column="3"
                        Margin="10,0,0,0">

                            <TextBlock Text="Sensor Category"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                            <ComboBox x:Name="SensorCategoryComboBox"
                          Height="35"
                          Padding="8">

                                <ComboBoxItem Content="Environmental"/>
                                <ComboBoxItem Content="PowerConsumption"/>
                                <ComboBoxItem Content="Actuator"/>

                            </ComboBox>

                        </StackPanel>

                    </Grid>

                    <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,15,0,0">

                        <Button Content="Register Sensor"
                    Width="150"
                    Height="35"
                    Click="RegisterSensorButton_Click"/>

                        <TextBlock x:Name="RegistrationStatusTextBlock"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       FontWeight="SemiBold"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Media / Attachment -->
            <Border Grid.Row="7"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                   Text="Sensor File Attachment"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                    <!-- Upload controls -->
                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sensor -->
                        <ComboBox x:Name="AttachmentSensorComboBox"
                      Grid.Column="0"
                      Height="35"
                      Margin="0,0,10,0"
                      SelectionChanged="AttachmentSensorComboBox_SelectionChanged"/>

                        <!-- Choose file -->
                        <Button Grid.Column="1"
                    Content="Choose File"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="ChooseAttachmentButton_Click"/>

                        <!-- Status -->
                        <TextBlock x:Name="AttachmentStatusTextBlock"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontWeight="SemiBold"/>

                        <!-- Download the selected file from the list below -->
                        <Button Grid.Column="3"
                    Content="Download Selected"
                    Width="150"
                    Height="35"
                    Click="DownloadAttachmentButton_Click"/>

                    </Grid>

                    <!-- Uploaded files heading -->
                    <TextBlock Grid.Row="2"
                   Text="Uploaded Files"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,20,0,10"/>

                    <!-- Uploaded files list -->
                    <ListBox x:Name="AttachmentsListBox"
                 Grid.Row="3"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,5">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                       Text="{Binding FileName}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                       Text="{Binding FileSize}"
                                       Margin="20,0"
                                       VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                       Text="{Binding UploadedAt}"
                                       VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- Historical Telemetry Search -->
            <Border Grid.Row="8"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                   Text="Historical Telemetry Search"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                    <!-- Search controls -->
                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="SearchSensorComboBox"
                      Grid.Column="0"
                      Height="35"
                      Margin="0,0,10,0"/>

                        <ComboBox x:Name="SearchTypeComboBox"
                      Grid.Column="1"
                      Width="160"
                      Height="35"
                      Margin="0,0,10,0">

                            <ComboBoxItem Content="Soil Moisture"
                              IsSelected="True"/>

                            <ComboBoxItem Content="Power"/>

                            <ComboBoxItem Content="Valve"/>

                        </ComboBox>

                        <Button Grid.Column="2"
                    Content="Search"
                    Width="100"
                    Height="35"
                    Click="SearchTelemetryButton_Click"/>

                    </Grid>

                    <!-- Search information -->
                    <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,15,0,10">

                        <TextBlock Text="Algorithm:"
                       FontWeight="SemiBold"/>

                        <TextBlock x:Name="SearchAlgorithmText"
                       Text="--"
                       Margin="5,0,25,0"/>

                        <TextBlock Text="Results:"
                       FontWeight="SemiBold"/>

                        <TextBlock x:Name="SearchResultsText"
                       Text="0"
                       Margin="5,0,25,0"/>

                        <TextBlock Text="Search Time:"
                       FontWeight="SemiBold"/>

                        <TextBlock x:Name="SearchTimeText"
                       Text="--"
                       Margin="5,0,0,0"/>

                    </StackPanel>

                    <!-- Results -->
                    <ListBox Grid.Row="3"
                 x:Name="SearchResultsListBox"
                 Height="150"
                 BorderThickness="0">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,0,5">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Timestamp}"
                                       Width="220"/>

                                        <TextBlock Text="{Binding Value}"
                                       FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>


            <!-- Sensor List -->
            <Border Grid.Row="10"
                Background="White"
                CornerRadius="8"
                Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                           Text="Registered Sensors"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1"
                          x:Name="SensorsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Device"
                                            Binding="{Binding DeviceIdentifier}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Location"
                                            Binding="{Binding DeploymentLocation}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Zone"
                                            Binding="{Binding Zone}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Last Seen"
                                            Binding="{Binding LastSeen}"
                                            Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- Dynamic Engagement - Smart-X Environment Health -->
            <Border Grid.Row="9"
        Background="White"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                   Text="Smart-X Environment Health"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Health Score -->
                        <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center">

                            <TextBlock x:Name="HealthScoreText"
                           Text="--"
                           FontSize="42"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                            <TextBlock Text="HEALTH SCORE"
                           FontSize="11"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>

                        </StackPanel>

                        <!-- Recommendation -->
                        <StackPanel Grid.Column="1"
                        Margin="30,0,0,0">

                            <TextBlock x:Name="HealthStatusText"
                           Text="Analysing environment..."
                           FontSize="18"
                           FontWeight="SemiBold"/>

                            <TextBlock x:Name="HealthRecommendationText"
                           Text=""
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>

                        </StackPanel>

                    </Grid>

                    <!-- Health details -->
                    <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,20,0,0">

                        <TextBlock Text="Online Sensors:"
                       FontWeight="SemiBold"/>

                        <TextBlock x:Name="HealthOnlineText"
                       Text="0"
                       Margin="5,0,30,0"/>

                        <TextBlock Text="Offline Sensors:"
                       FontWeight="SemiBold"/>

                        <TextBlock x:Name="HealthOfflineText"
                       Text="0"
