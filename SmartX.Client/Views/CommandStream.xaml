<UserControl x:Class="SmartX.Client.Views.CommandStream"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172B4D"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#63738A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#63738A"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20" LastChildFill="False">
                <Button Content="← Main Menu"
                        Padding="12,8"
                        Margin="0,0,16,0"
                        Click="Back_Click"
                        DockPanel.Dock="Left"/>
                <Button Content="Refresh"
                        Padding="14,8"
                        Click="Refresh_Click"
                        DockPanel.Dock="Right"/>
                <CheckBox x:Name="AutoRefreshCheckBox"
                          Content="Auto-refresh"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          DockPanel.Dock="Right"/>
            </DockPanel>

            <TextBlock Text="Real-Time Command Stream &amp; History"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>
            <TextBlock Text="Watch your devices, act on suggestions, send commands and review what happened."
                       Foreground="#63738A"
                       Margin="0,6,0,20"/>

            <!-- 1. Live telemetry -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text=" · Live Sensor Telemetry" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="LiveTelemetryStatusTextBlock"
                               Text="Waiting for readings..."
                               Style="{StaticResource Hint}"/>

                    <WrapPanel Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Device" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="LiveDeviceFilterComboBox"
                                      Width="180" Height="30"
                                      SelectionChanged="LiveTelemetryFilter_Changed">
                                <ComboBoxItem Content="All devices" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Category" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="LiveCategoryFilterComboBox"
                                      Width="160" Height="30" SelectedIndex="0"
                                      SelectionChanged="LiveTelemetryFilter_Changed">
                                <ComboBoxItem Content="All categories"/>
                                <ComboBoxItem Content="Soil Moisture"/>
                                <ComboBoxItem Content="Power"/>
                                <ComboBoxItem Content="Valve"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Alerts" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="LiveAlertFilterComboBox"
                                      Width="160" Height="30" SelectedIndex="0"
                                      SelectionChanged="LiveTelemetryFilter_Changed">
                                <ComboBoxItem Content="All readings"/>
                                <ComboBoxItem Content="Active alert"/>
                                <ComboBoxItem Content="No active alert"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <DataGrid x:Name="LiveTelemetryGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="150"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceIdentifier}" Width="*"/>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                            <DataGridTextColumn Header="Reading" Binding="{Binding DisplayValue}" Width="*"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="1.5*"/>
                            <DataGridTextColumn Header="Alert" Binding="{Binding AlertState}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="LiveTelemetryMessageTextBlock"
                               Text="Readings will appear here."
                               Style="{StaticResource Hint}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. Alerts -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text=" · Alerts" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="AlertsStatusTextBlock"
                               Text="Waiting for alerts..."
                               Style="{StaticResource Hint}"/>

                    <TextBlock Text="Critical alerts first (priority queue)" Style="{StaticResource Label}"/>
                    <DataGrid x:Name="PriorityAlertsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="90"
                              MaxHeight="200"
                              Margin="0,0,0,14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceIdentifier}" Width="*"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*"/>
                            <DataGridTextColumn Header="Raised" Binding="{Binding Raised}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Active errors (unique)" Style="{StaticResource Label}"/>
                            <ListBox x:Name="ActiveErrorsListBox"
                                     MinHeight="60" MaxHeight="140"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Disconnected devices (unique)" Style="{StaticResource Label}"/>
                            <ListBox x:Name="DisconnectedDevicesListBox"
                                     MinHeight="60" MaxHeight="140"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Suggestions -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text=" · Suggested Actions &amp; Insights" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Based on alerts, trends and what operators usually do next."
                               Style="{StaticResource Hint}"/>

                    <TextBlock Text="Suggested actions" Style="{StaticResource Label}"/>
                    <ListBox x:Name="SuggestedActionsListBox"
                             MinHeight="70" MaxHeight="180"
                             Margin="0,0,0,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                    <TextBlock Text="Automated insights" Style="{StaticResource Label}"/>
                    <ListBox x:Name="AutomatedInsightsListBox"
                             MinHeight="70" MaxHeight="180"
                             Margin="0,0,0,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh suggestions"
                                Padding="14,8"
                                Click="RefreshRecommendations_Click"/>
                        <TextBlock x:Name="RecommendationStatusTextBlock"
                                   Text="Not loaded yet."
                                   Foreground="#63738A"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Send a command -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text=" · Send a Command" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Submit a command, run the next one in the queue, or undo the last one."
                               Style="{StaticResource Hint}"/>

                    <WrapPanel Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Device" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="DeviceComboBox"
                                      IsEditable="True"
                                      Width="200" Height="30"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Command" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CommandComboBox"
                                      Width="200" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="EnableTelemetry"/>
                                <ComboBoxItem Content="DisableTelemetry"/>
                                <ComboBoxItem Content="TogglePump"/>
                                <ComboBoxItem Content="ToggleRelay"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Note" Style="{StaticResource Label}"/>
                            <TextBox x:Name="DescriptionTextBox"
                                     Width="280" Height="30"
                                     VerticalContentAlignment="Center"
                                     Text="Manual command from Command Stream"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Submit"
                                Padding="16,8" Margin="0,0,8,0"
                                Click="SubmitCommand_Click"/>
                        <Button Content="Execute Next"
                                Padding="16,8" Margin="0,0,8,0"
                                Click="ExecuteNext_Click"/>
                        <Button Content="Undo Last"
                                Padding="16,8"
                                Click="UndoCommand_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. History -->
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text=" · Command History" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Search by device, command or result."
                               Style="{StaticResource Hint}"/>

                    <WrapPanel Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Search" Style="{StaticResource Label}"/>
                            <TextBox x:Name="SearchTextBox"
                                     Width="260" Height="30"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Status" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="StatusFilterComboBox"
                                      Width="140" Height="30" SelectedIndex="0"
                                      SelectionChanged="StatusFilter_SelectionChanged">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Pending"/>
                                <ComboBoxItem Content="Executed"/>
                                <ComboBoxItem Content="Failed"/>
                                <ComboBoxItem Content="Undone"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <Button Content="Pending only"
                                    Padding="12,6" Margin="0,0,8,0"
                                    Click="LoadPending_Click"/>
                            <Button Content="All history"
                                    Padding="12,6"
                                    Click="LoadHistory_Click"/>
                        </StackPanel>
                    </WrapPanel>

                    <DataGrid x:Name="CommandsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="200"
                              MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceIdentifier}" Width="*"/>
                            <DataGridTextColumn Header="Command" Binding="{Binding CommandType}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="160"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding ResultMessage}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="MessageTextBlock"
                               Text="Ready."
                               Style="{StaticResource Hint}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>